; Renuevo Pixel — versión 2D en pixel art (Godot 4.3)
config_version=5

[application]

config/name="Renuevo Pixel"
config/description="Restaura la tierra y vete sin dejar rastro."
config/version="3.4"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.118, 0.078, 0.055, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="RenuevoPixel"

[autoload]

D="*res://scripts/data.gd"
Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.118, 0.078, 0.055, 1)
