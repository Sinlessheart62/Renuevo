; Renuevo — proyecto Godot 4.3
config_version=5

[application]

config/name="Renuevo Pixel"
config/description="Restaura la tierra y vete sin dejar rastro."
config/version="2.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.078, 0.067, 0.051, 1)
boot_splash/show_image=false
config/windows_native_icon=""
config/use_custom_user_dir=true
config/custom_user_dir_name="RenuevoPixel"

[autoload]

D="*res://scripts/data.gd"
Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/ssao/quality=3
environment/defaults/default_clear_color=Color(0.078, 0.067, 0.051, 1)
textures/canvas_textures/default_texture_filter=0
