shader_type canvas_item;
// Paleta terrosa limitada + tramado ordenado suave (estilo pixel art de granja).
uniform float dither = 0.008;
uniform float amount = 1.0;
const int N = 46;
const vec3 PAL[46] = vec3[](
	vec3(0.082,0.063,0.055), vec3(0.165,0.102,0.071), vec3(0.290,0.180,0.110), vec3(0.420,0.267,0.157),
	vec3(0.549,0.353,0.196), vec3(0.690,0.478,0.271), vec3(0.816,0.604,0.361), vec3(0.910,0.769,0.549),
	vec3(0.949,0.886,0.753), vec3(1.000,0.953,0.863),
	vec3(0.141,0.200,0.106), vec3(0.200,0.282,0.122), vec3(0.247,0.353,0.141), vec3(0.337,0.463,0.180),
	vec3(0.431,0.561,0.216), vec3(0.541,0.651,0.290), vec3(0.663,0.749,0.388), vec3(0.784,0.839,0.494),
	vec3(0.180,0.247,0.220), vec3(0.247,0.361,0.310),
	vec3(0.227,0.227,0.251), vec3(0.369,0.365,0.388), vec3(0.541,0.533,0.565), vec3(0.722,0.714,0.729), vec3(0.878,0.882,0.894),
	vec3(0.122,0.208,0.314), vec3(0.180,0.353,0.478), vec3(0.290,0.525,0.659), vec3(0.498,0.714,0.812), vec3(0.749,0.878,0.918),
	vec3(0.541,0.180,0.165), vec3(0.753,0.325,0.227), vec3(0.910,0.604,0.541), vec3(0.949,0.753,0.690),
	vec3(0.290,0.184,0.290), vec3(0.478,0.310,0.478), vec3(0.659,0.478,0.659),
	vec3(0.788,0.635,0.227), vec3(0.925,0.816,0.416), vec3(0.910,0.392,0.118), vec3(1.000,0.690,0.251),
	vec3(1.000,1.000,1.000), vec3(0.380,0.420,0.180), vec3(0.600,0.560,0.300), vec3(0.200,0.420,0.400), vec3(0.420,0.640,0.600)
);
float bayer(vec2 p){
	ivec2 i = ivec2(mod(p, 4.0));
	int m[16] = int[](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
	return float(m[i.y * 4 + i.x]) / 16.0 - 0.47;
}
void fragment(){
	vec3 c = texture(TEXTURE, UV).rgb;
	vec2 tp = UV / TEXTURE_PIXEL_SIZE;
	vec3 q = c + bayer(floor(tp)) * dither;
	float best = 1e9; vec3 bc = c;
	for (int i = 0; i < N; i++){
		vec3 d = q - PAL[i];
		float e = dot(d * d, vec3(0.30, 0.59, 0.11));
		if (e < best){ best = e; bc = PAL[i]; }
	}
	COLOR = vec4(mix(c, bc, amount), 1.0);
}
